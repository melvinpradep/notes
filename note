package generator_test

import (
	"strings"
	"testing"

	"jmxgen-stephandler-nested/internal/generator"
)

// TestSetBody ensures SetBody correctly formats and escapes JSON to JMeter style.
func TestSetBody(t *testing.T) {
	b := generator.NewJMXBuilder()

	path := "test_body.json"
	json := `{
	  "query": "<a&b>",
	  "user": {
	    "name": "John",
	    "roles": ["admin", "test"]
	  }
	}`
	if err := os.WriteFile(path, []byte(json), 0644); err != nil {
		t.Fatalf("failed to write test file: %v", err)
	}
	defer os.Remove(path)

	if err := b.SetBody(path); err != nil {
		t.Fatalf("SetBody() error = %v", err)
	}

	got := b.Ctx.API.BodyEscaped
	wantSubstrings := []string{
		"&quot;query&quot;",
		"&lt;a&amp;b&gt;",
		"&#xd;",
	}

	for _, sub := range wantSubstrings {
		if !strings.Contains(got, sub) {
			t.Errorf("expected escaped body to contain %q\nGot:\n%s", sub, got)
		}
	}
}

// TestSetRequest verifies method and path are captured correctly.
func TestSetRequest(t *testing.T) {
	b := generator.NewJMXBuilder()
	if err := b.SetRequest("post", "/user/test"); err != nil {
		t.Fatalf("SetRequest() failed: %v", err)
	}

	if b.Ctx.API.Method != "POST" {
		t.Errorf("expected method POST, got %s", b.Ctx.API.Method)
	}
	if b.Ctx.API.Path != "/user/test" {
		t.Errorf("expected path /user/test, got %s", b.Ctx.API.Path)
	}
}

// TestSetDuration verifies duration conversion to seconds.
func TestSetDuration(t *testing.T) {
	b := generator.NewJMXBuilder()
	if err := b.SetDuration(5); err != nil {
		t.Fatalf("SetDuration() failed: %v", err)
	}
	if b.Ctx.Perf.DurSec != 300 {
		t.Errorf("expected 300 seconds, got %d", b.Ctx.Perf.DurSec)
	}
}

// TestBuild ensures JMX template rendering works with basic data.
func TestBuild(t *testing.T) {
	b := generator.NewJMXBuilder()
	b.Ctx.Perf.DurSec = 300
	b.Ctx.API.Host = "https://example.com"
	b.Ctx.API.Method = "POST"
	b.Ctx.API.Path = "/test"
	b.Ctx.API.BodyEscaped = `{&quot;msg&quot;:&quot;ok&quot;}`

	out, err := b.Build()
	if err != nil {
		t.Fatalf("Build() error = %v", err)
	}

	if !strings.Contains(out, "HTTPSamplerProxy") {
		t.Errorf("expected Build output to contain HTTPSamplerProxy")
	}
}
