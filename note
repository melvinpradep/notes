	if len(mockCtx.registeredSteps) != len(expectedPatterns) {
		t.Fatalf("expected %d steps, got %d", len(expectedPatterns), len(mockCtx.registeredSteps))
	}

	for i, pattern := range expectedPatterns {
		if !reflect.DeepEqual(pattern, mockCtx.registeredSteps[i]) {
			t.Errorf("expected step[%d] = %s, got %s", i, pattern, mockCtx.registeredSteps[i])
		}
	}
